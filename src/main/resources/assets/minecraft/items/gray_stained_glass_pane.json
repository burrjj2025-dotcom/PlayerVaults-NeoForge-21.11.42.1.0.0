{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "player_vaults:previous_button",
        "model": {
          "type": "minecraft:model",
          "model": "player_vaults:item/previous_button"
        }
      },
      {
        "when": "player_vaults:next_button",
        "model": {
          "type": "minecraft:model",
          "model": "player_vaults:item/next_button"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/gray_stained_glass_pane"
    }
  }
}
